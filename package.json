{
  "name": "adguard-mqtt-bridge",
  "version": "1.0.0",
  "description": "A lightweight Node.js service that connects your AdguardHome with MQTT.",
  "keywords": [
    "adguardhome",
    "mqtt",
    "bridge"
  ],
  "author": {
    "name": "Tobias Wälde",
    "email": "tobias.waelde@gmail.com",
    "url": "https://tobiaswaelde.com"
  },
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --config \"./nodemon.json\"",
    "prebuild": "rimraf build",
    "build": "tsc",
    "test": "yarn build && node --test test/*.test.cjs",
    "prebundle": "yarn build && rimraf ./dist",
    "bundle": "ncc build build/index.js -o dist -m",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/signale": "^1.4.7",
    "@vercel/ncc": "^0.45.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "dotenv": "18.0.9",
    "envalid": "^9.0.0",
    "mqtt": "^5.16.1",
    "signale": "^1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mqtt-bridges/adguardhome.git"
  },
  "homepage": "https://github.com/open-mqtt-bridges/adguardhome#readme",
  "bugs": {
    "url": "https://github.com/open-mqtt-bridges/adguardhome/issues"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "nodemon/minimatch": "^11.0.5",
    "**/ws": "8.22.1",
    "**/follow-redirects": "1.16.2"
  }
}
